{
 "0": {
  "speaker": "Kappei",
  "lines": [
   "Come on, you scum!",
   "We won't hand the future of",
   "everyone's Earth to you!!"
  ]
 },
 "1": {
  "speaker": "Fudo",
  "lines": [
   "Good. Wing of the Sun -",
   "to cross blades with you",
   "truly revived, I am glad."
  ]
 },
 "2": {
  "speaker": "Ziene",
  "lines": [
   "I won't let the tragedy of",
   "the Break the World happen",
   "a second time!"
  ]
 },
 "3": {
  "speaker": "Rand",
  "lines": [
   "Ziene Espio... you..."
  ]
 },
 "4": {
  "speaker": "Ziene",
  "lines": [
   "The world wants peace!",
   "That is what I fight for!"
  ]
 },
 "5": {
  "speaker": "Ziene",
  "lines": [
   "But you are the exception!",
   "For his sake, you I will",
   "strike down myself!!"
  ]
 },
 "6": {
  "speaker": "Mel",
  "lines": [
   "!"
  ]
 },
 "7": {
  "speaker": "Rand",
  "lines": [
   "What's wrong, Mel!",
   "Got the hiccups?!"
  ]
 },
 "8": {
  "speaker": "Mel",
  "lines": [
   "N-nothing! It's",
   "nothing at all!!"
  ]
 },
 "9": {
  "speaker": "Mel",
  "lines": [
   "(My belly's been tingling...",
   "Is something about to happen?)"
  ]
 },
 "10": {
  "speaker": "Ziene",
  "lines": [
   "Good timing, The Crusher!",
   "We settle this here!"
  ]
 },
 "11": {
  "speaker": "Rand",
  "lines": [
   "Forget it! I'm not fighting",
   "big sis on a battlefield",
   "this messed up!!"
  ]
 },
 "12": {
  "speaker": "Mel",
  "lines": [
   "Answer me! Does Chimera",
   "think it's fine even if the",
   "world is destroyed?!"
  ]
 },
 "13": {
  "speaker": "Rand",
  "lines": [
   "Looks like you've got your",
   "reasons, big sis!"
  ]
 },
 "14": {
  "speaker": "Quattro",
  "lines": [
   "Reccoa..."
  ]
 },
 "15": {
  "speaker": "Reccoa",
  "lines": [
   "Having lost Scirocco, we",
   "have nowhere left to return."
  ]
 },
 "16": {
  "speaker": "Emma",
  "lines": [
   "So that's why you came",
   "back to $c?"
  ]
 },
 "17": {
  "speaker": "Reccoa",
  "lines": [
   "...If I'm to die fighting",
   "anyway, I wanted to do",
   "something with meaning..."
  ]
 },
 "18": {
  "speaker": "Kamille",
  "lines": [
   "And that means fighting",
   "with $c?"
  ]
 },
 "19": {
  "speaker": "Reccoa",
  "lines": [
   "...That's right..."
  ]
 },
 "20": {
  "speaker": "Sara",
  "lines": [
   "I have no intention of",
   "forgiving you who killed",
   "Lord Paptimus."
  ]
 },
 "21": {
  "speaker": "Katz",
  "lines": [
   "Sara! Still saying that!"
  ]
 },
 "22": {
  "speaker": "Sara",
  "lines": [
   "...But... I hate just dying..."
  ]
 },
 "23": {
  "speaker": "Sara",
  "lines": [
   "If I couldn't save Lord Paptimus,",
   "at least let me use the power",
   "he saw in me..."
  ]
 },
 "24": {
  "speaker": "Kamille",
  "lines": [
   "Reccoa, Sara... Scirocco is",
   "gone now, but the two of",
   "you are alive."
  ]
 },
 "25": {
  "speaker": "Kamille",
  "lines": [
   "From now on, live by your own will."
  ]
 },
 "26": {
  "speaker": "Quattro",
  "lines": [
   "I force nothing on you."
  ]
 },
 "27": {
  "speaker": "Quattro",
  "lines": [
   "But if anything in what we do",
   "moves you, lend us your strength."
  ]
 },
 "28": {
  "speaker": "Reccoa",
  "lines": [
   "...You've changed a little."
  ]
 },
 "29": {
  "speaker": "Quattro",
  "lines": [
   "Hearing that from you gladdens me."
  ]
 },
 "30": {
  "speaker": "Quattro",
  "lines": [
   "And it shames me for who I was.",
   "Along with bitter regret."
  ]
 },
 "31": {
  "speaker": "Reccoa",
  "lines": [
   "I'll change too... So I can",
   "live in a world without you",
   "and without Scirocco."
  ]
 },
 "32": {
  "speaker": "Sara",
  "lines": [
   "Reccoa Londe..."
  ]
 },
 "33": {
  "speaker": "Reccoa",
  "lines": [
   "Live, Sara. You live too,",
   "and walk on your own feet."
  ]
 },
 "34": {
  "speaker": "Sara",
  "lines": [
   "Thank you, Katz..."
  ]
 },
 "35": {
  "speaker": "Shinn",
  "lines": [
   "Rey..."
  ]
 },
 "36": {
  "speaker": "Rey",
  "lines": [
   "Don't worry about my life,",
   "Shinn. I only do what I can."
  ]
 },
 "37": {
  "speaker": "Rey",
  "lines": [
   "Together with you all."
  ]
 },
 "38": {
  "speaker": "Shinn",
  "lines": [
   "We can fight together again, Rey."
  ]
 },
 "39": {
  "speaker": "Rey",
  "lines": [
   "You and $c showed me",
   "a tomorrow. ...Thank you,",
   "Shinn."
  ]
 },
 "40": {
  "speaker": "Shinn",
  "lines": [
   "I just... wanted to talk",
   "with you like this again."
  ]
 },
 "41": {
  "speaker": "Rey",
  "lines": [
   "Let's go, Shinn. We protect",
   "tomorrow by fighting."
  ]
 },
 "42": {
  "speaker": "Shinn",
  "lines": [
   "Yeah...!"
  ]
 },
 "43": {
  "speaker": "Rey",
  "lines": [
   "And I'll hand you this..."
  ]
 },
 "44": {
  "speaker": "Shinn",
  "lines": [
   "This... Mayu's phone..."
  ]
 },
 "45": {
  "speaker": "Rey",
  "lines": [
   "Your belongings were disposed",
   "of, but I kept this one."
  ]
 },
 "46": {
  "speaker": "Shinn",
  "lines": [
   "Thank you, Rey..."
  ]
 },
 "47": {
  "speaker": "Lunamaria",
  "lines": [
   "Rey... Shinn..."
  ]
 },
 "48": {
  "speaker": "Shinn",
  "lines": [
   "(Mayu... Father, Mother...",
   "watch over me...)"
  ]
 },
 "49": {
  "speaker": "Shinn",
  "lines": [
   "(I'll protect it, I swear.",
   "This world, with my comrades...)"
  ]
 }
}
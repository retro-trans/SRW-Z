{
 "50": {
  "speaker": "Hilda",
  "lines": [
   "What in the world is that",
   "giant beam cannon?!"
  ]
 },
 "51": {
  "speaker": "Talho",
  "lines": [
   "I saw it in classified files",
   "back when I was in the army..."
  ]
 },
 "52": {
  "speaker": "Talho",
  "lines": [
   "That's Oratorio No.8... a",
   "weapon that fires microwaves."
  ]
 },
 "53": {
  "speaker": "Gain",
  "lines": [
   "So that's what sniped the",
   "Messiah...?!"
  ]
 },
 "54": {
  "speaker": "Adette",
  "lines": [
   "Attacking the Messiah now,",
   "wrecked as it is - what for?!"
  ]
 },
 "55": {
  "speaker": "Holland",
  "lines": [
   "It's Dewey's doing...! It's to",
   "wipe out the Coralians, no",
   "question!"
  ]
 },
 "56": {
  "speaker": "Holland",
  "lines": [
   "We're moving out! I won't let",
   "his way of doing things stand!"
  ]
 },
 "57": {
  "speaker": "Renton",
  "lines": [
   "Eureka..."
  ]
 },
 "58": {
  "speaker": "???",
  "lines": [
   "Don't come...!"
  ]
 },
 "59": {
  "speaker": "Maurice",
  "lines": [
   "Mama...!"
  ]
 },
 "60": {
  "speaker": "Maurice",
  "lines": [
   "What's wrong...?!",
   "Does your tummy hurt?!"
  ]
 },
 "61": {
  "speaker": "???",
  "lines": [
   "Just don't! None of you come!"
  ]
 },
 "62": {
  "speaker": "Maurice",
  "lines": [
   "Mama...! Have you come",
   "to hate us?!"
  ]
 },
 "63": {
  "speaker": "Eureka",
  "lines": [
   "No...! It's not that, but..."
  ]
 },
 "64": {
  "speaker": "Renton",
  "lines": [
   "Eureka... that form...?!"
  ]
 },
 "65": {
  "speaker": "Eureka",
  "lines": [
   "I don't know... Just now my",
   "body suddenly went hot..."
  ]
 },
 "66": {
  "speaker": "Maurice",
  "lines": [
   "Is it the mark of a Coralian...?"
  ]
 },
 "67": {
  "speaker": "Garrod",
  "lines": [
   "What's wrong, Tiffa?!"
  ]
 },
 "68": {
  "speaker": "Tiffa",
  "lines": [
   "What is this...? Countless",
   "lives... beyond counting..."
  ]
 },
 "69": {
  "speaker": "Tiffa",
  "lines": [
   "No... not a number. So many,",
   "and yet... one life?"
  ]
 },
 "70": {
  "speaker": "Renton",
  "lines": [
   "Don't tell me the Coralians",
   "beyond the dimension are",
   "awakening?!"
  ]
 },
 "71": {
  "speaker": "Eureka",
  "lines": [
   "...Please... don't look..."
  ]
 },
 "72": {
  "speaker": "Eureka",
  "lines": [
   "...And I thought we could",
   "finally be together..."
  ]
 },
 "73": {
  "speaker": "Eureka",
  "lines": [
   "It's cruel... why..."
  ]
 },
 "74": {
  "speaker": "Garrod",
  "lines": [
   "Eureka..."
  ]
 },
 "75": {
  "speaker": "Renton",
  "lines": [
   "Eureka... does it hurt?"
  ]
 },
 "76": {
  "speaker": "Eureka",
  "lines": [
   "Eh... No, it doesn't, but..."
  ]
 },
 "77": {
  "speaker": "Renton",
  "lines": [
   "Good. Then it's all right."
  ]
 },
 "78": {
  "speaker": "Eureka",
  "lines": [
   "What are you saying?! I'm",
   "not the same as everyone!",
   "I'm a different creature!"
  ]
 },
 "79": {
  "speaker": "Renton",
  "lines": [
   "But you're Eureka!"
  ]
 },
 "80": {
  "speaker": "Eureka",
  "lines": [
   "Renton..."
  ]
 },
 "81": {
  "speaker": "Renton",
  "lines": [
   "I promised, didn't I? That",
   "I'd stay by you and protect you."
  ]
 },
 "82": {
  "speaker": "Renton",
  "lines": [
   "So smile. It's all right to",
   "smile, Eureka..."
  ]
 },
 "83": {
  "speaker": "Renton",
  "lines": [
   "Right? Hey... Maurice,",
   "Maeter, Linck?"
  ]
 },
 "84": {
  "speaker": "Maurice",
  "lines": [
   "Yeah! Mama is Mama!"
  ]
 },
 "85": {
  "speaker": "Maurice",
  "lines": [
   "You won't go anywhere, Mama?!"
  ]
 },
 "86": {
  "speaker": "Eureka",
  "lines": [
   "Y-yeah..."
  ]
 },
 "87": {
  "speaker": "Renton",
  "lines": [
   "Maurice, what about you?"
  ]
 },
 "88": {
  "speaker": "Maurice",
  "lines": [
   "...It's your fault, Renton..."
  ]
 },
 "89": {
  "speaker": "Renton",
  "lines": [
   "Eh..."
  ]
 },
 "90": {
  "speaker": "Maurice",
  "lines": [
   "You came, and Mama changed,",
   "and turned into this!"
  ]
 },
 "91": {
  "speaker": "Eureka",
  "lines": [
   "Stop it, Maurice...!"
  ]
 },
 "92": {
  "speaker": "Maurice",
  "lines": [
   "Why does Mama like Renton...!"
  ]
 },
 "93": {
  "speaker": "Maurice",
  "lines": [
   "Not fair! Mama killed our real",
   "mama, and now throws us away",
   "for Renton!"
  ]
 },
 "94": {
  "speaker": "Eureka",
  "lines": [
   "...So you knew, Maurice..."
  ]
 },
 "95": {
  "speaker": "Maurice",
  "lines": [
   "...Mama... don't go liking",
   "someone who isn't me...",
   "Look only at me... look more..."
  ]
 },
 "96": {
  "speaker": "Eureka",
  "lines": [
   "...Do you hate a Mama with",
   "a body like this?"
  ]
 }
}